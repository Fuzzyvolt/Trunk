#!/bin/sh
# Start/stop the LED daemon (owns LED D3 and button PB1).

DAEMON=/usr/bin/leddaemon
PIDFILE=/var/run/leddaemon.pid

case "$1" in
  start)
    printf "Starting leddaemon: "
    start-stop-daemon -S -q -b -m -p $PIDFILE -x $DAEMON && echo "OK" || echo "FAIL"
    ;;
  stop)
    printf "Stopping leddaemon: "
    start-stop-daemon -K -q -p $PIDFILE && echo "OK" || echo "FAIL"
    rm -f $PIDFILE
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
