#!/bin/sh
# Load/unload the myled_irq driver (LED D3 + button PB1, /dev/myled and /dev/mybutton).
# The driver binds to the "myled" device tree node as soon as it is loaded.
# It is installed by the Buildroot package microzed-modules in
# /lib/modules/<kernel version>/microzed/, so modprobe finds it by name.

NAME=myled_irq

loaded() { grep -q "^$NAME " /proc/modules; }

case "$1" in
  start)
    printf "Loading %s: " $NAME
    if loaded; then
      echo "already loaded"
    elif modprobe $NAME; then
      echo "OK"
    else
      echo "FAIL (see dmesg)"
    fi
    ;;
  stop)
    printf "Unloading %s: " $NAME
    if ! loaded; then
      echo "not loaded"
    elif rmmod $NAME; then
      echo "OK"
    else
      echo "FAIL (is /dev/myled or /dev/mybutton still open?)"
    fi
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
