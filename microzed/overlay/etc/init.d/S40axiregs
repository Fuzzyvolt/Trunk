#!/bin/sh
# Project 02: program the PL with axiregs.bin, then load the axiregs driver.
#
# Order matters: a PL address read with no logic behind it hangs the CPU,
# so the bitstream goes in first, the driver second.
#
# Bitstream loading uses the Xilinx kernel's FPGA manager sysfs files:
#   flags    0 = full bitstream (1 would be partial reconfiguration)
#   firmware file name; the kernel reads it from /lib/firmware/ and programs the PL
#   state    "operating" once the PL runs
# (fpgautil -b /lib/firmware/axiregs.bin does the same.)

FW=axiregs.bin
MGR=/sys/class/fpga_manager/fpga0
MOD=/lib/modules/axiregs/axiregs.ko
NAME=axiregs

loaded() { grep -q "^$NAME " /proc/modules; }

load_pl() {
  printf "Programming PL with %s: " $FW
  if [ ! -f /lib/firmware/$FW ]; then
    echo "FAIL (/lib/firmware/$FW missing)"
    return 1
  fi
  echo 0 > $MGR/flags
  if echo $FW > $MGR/firmware && [ "$(cat $MGR/state)" = "operating" ]; then
    echo "OK"
  else
    echo "FAIL (state: $(cat $MGR/state), see dmesg)"
    return 1
  fi
}

case "$1" in
  start)
    if loaded; then
      echo "$NAME: already loaded"
      exit 0
    fi
    load_pl || exit 1
    printf "Loading %s: " $NAME
    if insmod $MOD; then echo "OK"; else echo "FAIL (see dmesg)"; fi
    ;;
  stop)
    printf "Unloading %s: " $NAME
    if ! loaded; then
      echo "not loaded"
    elif rmmod $NAME; then
      echo "OK"
    else
      echo "FAIL"
    fi
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
