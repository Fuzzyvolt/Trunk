# Kernel config fragment for the MicroZed (linux-xlnx, xilinx_zynq_defconfig).
# Buildroot applies it on top of the defconfig:
#   make menuconfig -> Kernel -> "Additional configuration fragment files"
#   = /home/fabio/microzed-linux/microzed/configs/linux.fragment
# then: make linux-reconfigure && make
#
# Project 04: the Xilinx AXI DMA driver as a module instead of built in (=y).
# Built in, it binds at boot (the device tree has the DMA node), reads the DMA
# registers before the PL is programmed, and the CPU hangs. As a module,
# /etc/init.d/S40pl loads it after the bitstream (modprobe xilinx_dma).
CONFIG_XILINX_DMA=m
#
# Project 07: the IIO DMA buffer helpers (industrialio-buffer-dma.ko and
# industrialio-buffer-dmaengine.ko), used by modules/adciio. Nothing in
# xilinx_zynq_defconfig selects them. IIO and IIO_BUFFER are already on
# (the XADC driver needs them). Modules: modprobe adciio loads them first.
CONFIG_IIO_BUFFER_DMA=m
CONFIG_IIO_BUFFER_DMAENGINE=m
